{
  "name": "survey-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "bash scripts/build-single.sh",
    "test:rules": "firebase emulators:exec --only firestore --project avison-young-rental-survey \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
