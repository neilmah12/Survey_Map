{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "avison-young-rental-survey-dev",
      "public": "dist/editor",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [{ "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }]
    },
    {
      "site": "avison-young-rental-survey",
      "public": "dist/client",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "/s/**", "destination": "/client.html" }],
      "headers": [{ "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }]
    }
  ],
  "emulators": {
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
